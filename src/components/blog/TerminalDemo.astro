---
/**
 * TerminalDemo — a code block that becomes a runnable terminal.
 * Ported from apo docs (apps/docs/src/components/demos/TerminalDemo.astro).
 *
 * The command sits as a shell prompt line (`$ <command>`, selectable/copyable).
 * Click Run and the simulated response streams in line-by-line below, ending
 * on the verdict. Lets a reader feel the real loop without running anything.
 *
 * Lines support rich per-part coloring so the mock matches what the real CLI
 * prints (green PASS, red FAIL, bold headers, dim hints, ✓/✗ marks).
 * Each line is either a string (shorthand) or `{ parts: [{ text, tone }] }`.
 * Output is mocked — it doesn't run against anything real.
 *
 * Same idiom as HarnessLoop: self-themed dark panel (high-contrast in both
 * site themes), not-prose to escape the typography container, scoped styles,
 * prefers-reduced-motion (instant full output), astro:before-swap cleanup.
 */
type Tone = "default" | "danger" | "success" | "dim" | "bold";
type Part = { text: string; tone?: Tone };
type Line = string | { text?: string; tone?: Tone; parts?: Part[] };

interface Props {
	command: string | string[];
	lines: Line[];
}

const { command, lines } = Astro.props;
const commands = Array.isArray(command) ? command : [command];

// Shell-style highlight for the prompt line: binary bold, flags dim — purely
// visual (this is HTML, not real terminal output, so nothing parsing-related
// is affected).
const commandTokens = commands.map((cmd) =>
	cmd
		.split(" ")
		.map((token, i) => ({
			text: (i > 0 ? " " : "") + token,
			tone: i === 0 ? "bold" : token.startsWith("-") ? "dim" : undefined,
		})),
);

// Normalize each line into a parts[] array for rendering. Empty-string parts
// are dropped: Astro renders `{""}` as a stray text node, which would defeat
// the :empty rule on separator lines and pollute the stream text.
const normalized: Part[][] = lines.map((line) => {
	const parts =
		typeof line === "string"
			? [{ text: line }]
			: line.parts ?? [{ text: line.text ?? "", tone: line.tone }];
	return parts.filter((part) => part.text !== "");
});
---

<div class="terminal not-prose" data-terminal>
	<div class="terminal__prompt">
		<div class="terminal__command-block">
			{commands.map((cmd, ci) => (
				<div class="terminal__command-line">
					<span class="terminal__sigil" aria-hidden="true">$</span>
					<span class="terminal__command">{commandTokens[ci].map((t) => (<span class:list={t.tone ? ["t", `is-${t.tone}`] : undefined}>{t.text}</span>))}</span>
				</div>
			))}
		</div>
		<button class="terminal__run" type="button" data-run>
			<span data-run-label>Run</span>
		</button>
	</div>
	<div class="terminal__output" data-output aria-live="polite">
		{normalized.map((parts, i) => (
			<span class="terminal__line" data-line data-index={i}>{parts.map((part) => (<span class:list={["t", part.tone ? `is-${part.tone}` : ""]}>{part.text}</span>))}</span>
		))}
	</div>
</div>

<style>
	.terminal {
		margin: 1.5rem 0;
		border: 1px solid #232838;
		border-radius: 0.5rem;
		background: #0b0e16;
		color: #e6e9f2;
		font-family: ui-monospace, "SF Mono", "Cascadia Code", "Roboto Mono", monospace;
		font-size: 0.8rem;
		/* Lines exist in the DOM but hidden until streamed; reserve no height for them. */
		overflow: hidden;
	}

	.terminal__prompt {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 0.8rem;
		border-bottom: 1px solid transparent;
		transition: border-color 200ms ease;
	}

	/* Once output exists, separate the prompt from it with a hairline. */
	.terminal[data-streaming] .terminal__prompt,
	.terminal[data-done] .terminal__prompt {
		border-bottom-color: #232838;
	}

	.terminal__command-block {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.terminal__command-line {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.terminal__sigil {
		color: #5fe6ad;
		user-select: none;
		flex-shrink: 0;
	}

	.terminal__command {
		display: flex;
		min-width: 0;
		color: #e6e9f2;
		/* Keep each command on one line; overflow clips (flex drops the
		   whitespace-only text nodes Astro emits between mapped tokens, so
		   only the spaces inside token text render). */
		white-space: nowrap;
		overflow: hidden;
	}

	/* Token leading separators must survive white-space handling. */
	.terminal__command > span {
		flex-shrink: 0;
		white-space: pre;
	}

	.terminal__run {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.6rem;
		background: #11151f;
		border: 1px solid #2a3142;
		border-radius: 0.35rem;
		color: #c7ccd9;
		font: inherit;
		font-size: 0.7rem;
		cursor: pointer;
		transition:
			background-color 0.15s,
			border-color 0.15s,
			color 0.15s;
	}

	.terminal__run:hover:not(:disabled) {
		background: #181c28;
		border-color: #3a4154;
		color: #f3f5fb;
	}

	.terminal__run:disabled {
		cursor: default;
		opacity: 0.5;
	}

	/* Done state — the button reads "Run again" and sits at rest. */
	.terminal[data-done] .terminal__run {
		color: #8b93a7;
	}

	.terminal__output {
		padding: 0 0.8rem;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		/* Collapsed when idle; expands to natural height when output exists.
		   No fixed max-height — long outputs must be fully visible. Each line
		   animates in on its own. */
		max-height: 0;
		overflow: hidden;
		transition: max-height 200ms ease, padding 200ms ease;
	}

	.terminal[data-streaming] .terminal__output,
	.terminal[data-done] .terminal__output {
		/* Large enough that any realistic output fits; the container's real
		   height is governed by its flowing content, not this cap. */
		max-height: 60rem;
		padding-top: 0.55rem;
		padding-bottom: 0.6rem;
	}

	/* Lines exist statically but are hidden until their stream turn.
	   When a line is active, a blinking cursor sits at the end of the
	   visible text — simulating a terminal writing output.
	   Flex row (drops Astro's whitespace-only text nodes between parts);
	   fit-content so the line hugs its text and the end-of-line cursor sits
	   right after it, like the apo docs original. */
	.terminal__line {
		display: flex;
		width: fit-content;
		min-height: 0.6rem;
		color: #c7ccd9;
		opacity: 0;
	}

	.terminal__line[data-shown] {
		opacity: 1;
	}

	/* Cursor: a thin green block that blinks at the end of the active line. */
	.terminal__line[data-active]::after {
		content: "";
		display: inline-block;
		width: 0.45em;
		height: 1.1em;
		margin-left: 1px;
		background: #5fe6ad;
		vertical-align: text-bottom;
		animation: terminal-cursor 600ms steps(1) infinite;
	}

	@keyframes terminal-cursor {
		0%, 50% { opacity: 1; }
		51%, 100% { opacity: 0; }
	}

	/* Per-part tones — green PASS/✓, red FAIL/✗, dim hints, bold headers.
	   pre-wrap keeps leading/inner spacing intact while still letting long
	   lines wrap on narrow screens. */
	:global(.t) {
		color: #c7ccd9;
		white-space: pre-wrap;
	}
	:global(.t.is-success) {
		color: #5fe6ad;
	}
	:global(.t.is-danger) {
		color: #f5a088;
	}
	:global(.t.is-dim) {
		color: #8b93a7;
	}
	:global(.t.is-bold) {
		color: #f3f5fb;
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal__line {
			transition: none;
			transform: none;
		}
		.terminal__output {
			transition: none;
		}
	}
</style>

<script>
	// Typewriter effect: each line wipes in as a CSS clip-path transition,
	// sequenced line by line. Fast enough to feel snappy (~1s total) and
	// smooth regardless of JS timer throttling (embedded webviews clamp
	// timers, which wrecks any per-character JS stepping).
	const TARGET_TOTAL_MS = 1000;
	const LINE_START_GAP_MS = 30; // small pause when a new line begins

	function prefersReducedMotion(): boolean {
		return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	}

	function setupTerminal(root: HTMLElement) {
		if (root.dataset.inited) return;
		root.dataset.inited = "1";
		const runBtn = root.querySelector<HTMLButtonElement>("[data-run]");
		const runLabel = root.querySelector<HTMLElement>("[data-run-label]");
		const lines = Array.from(root.querySelectorAll<HTMLElement>("[data-line]"));
		if (!runBtn || !runLabel) return;

		// Pre-compute the full text of each line (from child spans) so we can
		// reveal characters progressively.
		const lineData = lines.map((line) => {
			const spans = Array.from(line.querySelectorAll<HTMLElement>(":scope > .t"));
			const fullText = spans.map((s) => s.textContent ?? "").join("");
			return { el: line, spans, fullText, length: fullText.length };
		});

		const totalChars = lineData.reduce((sum, l) => sum + Math.max(l.length, 1), 0);

		let streaming = false;
		const timers: number[] = [];

		function reset() {
			for (const { el, spans } of lineData) {
				el.removeAttribute("data-shown");
				el.removeAttribute("data-active");
				// Restore full text
				for (const span of spans) {
					span.style.visibility = "";
					span.style.clipPath = "";
					span.style.transition = "";
				}
			}
			root.removeAttribute("data-streaming");
			root.removeAttribute("data-done");
		}

		function stream() {
			if (streaming) return;
			streaming = true;
			reset();
			root.setAttribute("data-streaming", "");
			runBtn.disabled = true;
			runLabel.textContent = "Running";

			// Reduced motion: show all instantly.
			if (prefersReducedMotion()) {
				for (const { el } of lineData) el.setAttribute("data-shown", "");
				finish();
				return;
			}

			// Hide all span text initially
			for (const { spans } of lineData) {
				for (const span of spans) span.style.visibility = "hidden";
			}

			// Each line's reveal runs as a CSS transition on clip-path: the JS
			// only decides WHEN a line starts (one timer per line — coarse and
			// throttle-tolerant), and the browser interpolates the wipe. Timer
			// clamping in embedded webviews makes any per-character JS stepping
			// crawl or burst; a transition stays smooth regardless.
			let acc = 0;
			for (const line of lineData) {
				const startAt = acc;
				const dur = (Math.max(line.length, 1) / totalChars) * TARGET_TOTAL_MS;
				acc += dur + LINE_START_GAP_MS;

				timers.push(
					window.setTimeout(() => {
						line.el.setAttribute("data-shown", "");
						line.el.setAttribute("data-active", "");

						const total = Math.max(line.length, 1);
						let before = 0;
						for (const span of line.spans) {
							const spanText = span.textContent ?? "";
							const len = spanText.length;
							if (len === 0) continue;
							const delayK = (before / total) * dur;
							const durK = (len / total) * dur;
							span.style.transition = "none";
							span.style.clipPath = "inset(0 100% 0 0)";
							span.style.visibility = "visible";
							// commit the hidden state before starting the wipe
							void line.el.offsetWidth;
							span.style.transition = `clip-path ${durK}ms linear ${delayK}ms`;
							span.style.clipPath = "inset(0 0 0 0)";
							before += len;
						}

						// line done: clear the cursor and the inline styles
						timers.push(
							window.setTimeout(() => {
								line.el.removeAttribute("data-active");
								for (const span of line.spans) {
									span.style.transition = "";
									span.style.clipPath = "";
								}
							}, dur),
						);
					}, startAt),
				);
			}
			timers.push(
				window.setTimeout(() => {
					timers.forEach((t) => window.clearTimeout(t));
					finish();
				}, acc),
			);
		}

		function finish() {
			timers.forEach((t) => window.clearTimeout(t));
			// Per-line cleanup timers may have been cancelled above — strip any
			// remaining active-line state so no stray cursors survive.
			for (const { el, spans } of lineData) {
				el.removeAttribute("data-active");
				for (const span of spans) {
					span.style.transition = "";
					span.style.clipPath = "";
				}
			}
			streaming = false;
			root.removeAttribute("data-streaming");
			root.setAttribute("data-done", "");
			runBtn.disabled = false;
			runLabel.textContent = "Run again";
		}

		runBtn.addEventListener("click", stream);

		document.addEventListener(
			"astro:before-swap",
			() => {
				timers.forEach((t) => window.clearTimeout(t));
			},
			{ once: true },
		);
	}

	// Init now and on every Astro view-transition navigation — module scripts
	// execute once per page session, so client-side routed pages would else
	// keep a stale setup (or none at all) for their terminals.
	const initTerminals = () => {
		document
			.querySelectorAll<HTMLElement>("[data-terminal]:not([data-inited])")
			.forEach((root) => setupTerminal(root));
	};
	initTerminals();
	document.addEventListener("astro:page-load", initTerminals);
</script>
