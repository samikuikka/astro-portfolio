---
import { getAsset } from "~/utils/permalinks";
import interLatinWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const SITE_NAME = "Sami Kuikka";
const DEFAULT_TITLE = "Sami Kuikka — AI Engineer & Agentic Systems Builder";
const DEFAULT_DESCRIPTION =
  "Portfolio of Sami Kuikka, an AI engineer building agentic systems. Writing about agents, prompt optimization, RAG, and LLM evaluation.";

const { title, description = DEFAULT_DESCRIPTION, image } = Astro.props;

const pageTitle = title ? `${title} — ${SITE_NAME}` : DEFAULT_TITLE;
const site = Astro.site ?? new URL("https://www.samikuikka.com");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(
  image
    ? image.startsWith("/")
      ? image
      : `/${image}`
    : "/og/default.png",
  site
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />

<link rel="sitemap" href={getAsset("/sitemap-index.xml")} />
<link rel="canonical" href={canonical} />
<meta name="description" content={description} />
<title>{pageTitle}</title>

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:alt" content={pageTitle} />}
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

<link
  rel="preload"
  href={interLatinWoff2}
  as="font"
  type="font/woff2"
  crossorigin
/>
