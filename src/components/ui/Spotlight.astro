---
// Pure-CSS port of the former framer-motion Spotlight: two slowly drifting
// light beams behind the hero. No client JS.
---

<div class="spotlight" aria-hidden="true">
  <div class="spotlight-beam spotlight-left">
    <div class="beam beam-main"></div>
    <div class="beam beam-secondary beam-secondary-left"></div>
    <div class="beam beam-tertiary beam-tertiary-left"></div>
  </div>
  <div class="spotlight-beam spotlight-right">
    <div class="beam beam-main beam-main-right"></div>
    <div class="beam beam-secondary beam-secondary-right"></div>
    <div class="beam beam-tertiary beam-tertiary-right"></div>
  </div>
</div>

<style>
  .spotlight {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .spotlight-beam {
    position: absolute;
    top: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }

  .spotlight-left {
    left: 0;
  }

  .spotlight-right {
    right: 0;
  }

  .beam {
    position: absolute;
  }

  .beam-main {
    top: 0;
    left: 0;
    width: 560px;
    height: 1380px;
    background: radial-gradient(
      68.54% 68.72% at 55.02% 31.46%,
      hsla(210, 100%, 85%, 0.08) 0,
      hsla(210, 100%, 55%, 0.02) 50%,
      hsla(210, 100%, 45%, 0) 80%
    );
    transform: translateY(-350px) rotate(-45deg);
  }

  .beam-main-right {
    left: auto;
    right: 0;
    transform: translateY(-350px) rotate(45deg);
  }

  .beam-secondary {
    top: 0;
    left: 0;
    width: 240px;
    height: 1380px;
    transform-origin: top left;
    background: radial-gradient(
      50% 50% at 50% 50%,
      hsla(210, 100%, 85%, 0.06) 0,
      hsla(210, 100%, 55%, 0.02) 80%,
      transparent 100%
    );
    transform: rotate(-45deg) translate(5%, -50%);
  }

  .beam-secondary-right {
    left: auto;
    right: 0;
    transform-origin: top right;
    transform: rotate(45deg) translate(-5%, -50%);
  }

  .beam-tertiary {
    top: 0;
    left: 0;
    width: 240px;
    height: 1380px;
    transform-origin: top left;
    background: radial-gradient(
      50% 50% at 50% 50%,
      hsla(210, 100%, 85%, 0.04) 0,
      hsla(210, 100%, 45%, 0.02) 80%,
      transparent 100%
    );
    transform: rotate(-45deg) translate(-180%, -70%);
  }

  .beam-tertiary-right {
    left: auto;
    right: 0;
    transform-origin: top right;
    transform: rotate(45deg) translate(180%, -70%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .spotlight {
      animation: spotlight-fade-in 1.5s both;
    }

    .spotlight-left {
      animation: spotlight-drift-left 7s ease-in-out infinite alternate;
    }

    .spotlight-right {
      animation: spotlight-drift-right 7s ease-in-out infinite alternate;
    }
  }

  @keyframes spotlight-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes spotlight-drift-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(100px);
    }
  }

  @keyframes spotlight-drift-right {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100px);
    }
  }
</style>
